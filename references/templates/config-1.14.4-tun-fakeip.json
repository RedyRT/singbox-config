{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9091",
      "external_ui": "ui",
      "secret": "",
      "default_mode": "Rule"
    }
  },
  "dns": {
    "servers": [
      { "type": "hosts", "tag": "hosts" },
      {
        "type": "https",
        "tag": "remote-dns",
        "server": "1.1.1.1",
        "tls": { "enabled": true, "server_name": "cloudflare-dns.com" },
        "detour": "proxy"
      },
      { "type": "local", "tag": "local-dns" },
      { "type": "fakeip", "tag": "fakeip-dns", "inet4_range": "198.18.0.0/15" }
    ],
    "rules": [
      { "query_type": "AAAA", "action": "predefined", "rcode": "NOERROR" },
      { "preferred_by": "hosts", "action": "route", "server": "hosts" },
      { "clash_mode": "Direct", "action": "route", "server": "local-dns" },
      { "clash_mode": "Global", "action": "route", "server": "remote-dns" },
      { "rule_set": "geosite-ads", "action": "reject" },
      {
        "rule_set": "geosite-ru-blocked",
        "query_type": ["A", "AAAA"],
        "action": "route",
        "server": "fakeip-dns"
      },
      { "rule_set": "geosite-ru-blocked", "action": "route", "server": "remote-dns" }
    ],
    "final": "local-dns",
    "strategy": "ipv4_only",
    "reverse_mapping": true,
    "optimistic": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": "172.19.0.1/30",
      "auto_route": true,
      "dns_mode": "hijack",
      "strict_route": true,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": ["auto", "your-node-tag"],
      "default": "auto"
    },
    {
      "type": "selector",
      "tag": "blocked-services",
      "outbounds": ["proxy", "auto", "your-node-tag", "direct"],
      "default": "proxy"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": ["your-node-tag"],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    { "type": "direct", "tag": "direct" },
    {
      "type": "vless",
      "tag": "your-node-tag",
      "server": "your-server.example.com",
      "server_port": 443,
      "uuid": "your-uuid-here",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "your-sni.example.com",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "your-reality-public-key",
          "short_id": "your-short-id"
        }
      }
    }
  ],
  "route": {
    "rules": [
      { "action": "sniff" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [{ "protocol": "dns" }, { "port": 53 }],
        "action": "hijack-dns"
      },
      { "ip_is_private": true, "action": "route", "outbound": "direct" },
      { "clash_mode": "Direct", "action": "route", "outbound": "direct" },
      { "clash_mode": "Global", "action": "route", "outbound": "proxy" },
      { "rule_set": "geosite-ads", "action": "reject" },
      { "rule_set": "geosite-ru-blocked", "action": "route", "outbound": "blocked-services" }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-ru-blocked",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-ru-blocked.srs",
        "update_interval": "6h"
      },
      {
        "type": "remote",
        "tag": "geosite-ads",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-category-ads-all.srs",
        "update_interval": "6h"
      }
    ],
    "final": "direct",
    "auto_detect_interface": true,
    "default_domain_resolver": "local-dns",
    "default_http_client": "rule-set-proxy"
  },
  "http_clients": [
    { "tag": "rule-set-proxy", "detour": "proxy" }
  ]
}
