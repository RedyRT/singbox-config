{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9091",
      "external_ui": "ui",
      "secret": "",
      "default_mode": "Rule"
    }
  },
  "dns": {
    "servers": [
      {
        "type": "hosts",
        "tag": "hosts"
      },
      {
        "type": "https",
        "tag": "google-dns",
        "server": "8.8.8.8",
        "detour": "proxy"
      },
      {
        "type": "local",
        "tag": "local-dns"
      },
      {
        "type": "udp",
        "tag": "alidns",
        "server": "223.5.5.5"
      },
      {
        "type": "fakeip",
        "tag": "fakeip-dns",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "query_type": "AAAA",
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "preferred_by": "hosts",
        "action": "route",
        "server": "hosts"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "local-dns"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "google-dns"
      },
      {
        "rule_set": "geosite-ads",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-apple-cn",
          "geosite-microsoft-cn",
          "geosite-google-cn",
          "geosite-steam-cn"
        ],
        "action": "route",
        "server": "alidns"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip-dns"
      }
    ],
    "final": "google-dns",
    "strategy": "ipv4_only",
    "optimistic": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": "172.19.0.1/30",
      "auto_route": true,
      "dns_mode": "hijack",
      "strict_route": true,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "your-node-tag",
        "direct"
      ],
      "default": "auto"
    },
    {
      "type": "selector",
      "tag": "google",
      "outbounds": [
        "proxy",
        "auto",
        "your-node-tag",
        "direct"
      ],
      "default": "proxy"
    },
    {
      "type": "selector",
      "tag": "microsoft",
      "outbounds": [
        "proxy",
        "auto",
        "your-node-tag",
        "direct"
      ],
      "default": "proxy"
    },
    {
      "type": "selector",
      "tag": "apple",
      "outbounds": [
        "direct",
        "proxy",
        "auto",
        "your-node-tag"
      ],
      "default": "direct"
    },
    {
      "type": "selector",
      "tag": "ai",
      "outbounds": [
        "proxy",
        "auto",
        "your-node-tag"
      ],
      "default": "proxy"
    },
    {
      "type": "selector",
      "tag": "steam",
      "outbounds": [
        "proxy",
        "auto",
        "your-node-tag",
        "direct"
      ],
      "default": "proxy"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "your-node-tag"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "vless",
      "tag": "your-node-tag",
      "server": "your-server.example.com",
      "server_port": 443,
      "uuid": "your-uuid-here",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "your-sni.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "your-reality-public-key",
          "short_id": "your-short-id"
        }
      }
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "protocol": "stun"
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": "geosite-ads",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-openai",
          "geosite-anthropic",
          "geosite-jetbrains-ai",
          "geosite-category-ai-chat-!cn"
        ],
        "action": "route",
        "outbound": "ai"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-youtube"
        ],
        "action": "route",
        "outbound": "google"
      },
      {
        "rule_set": [
          "geosite-microsoft",
          "geosite-github"
        ],
        "action": "route",
        "outbound": "microsoft"
      },
      {
        "rule_set": "geosite-apple",
        "action": "route",
        "outbound": "apple"
      },
      {
        "rule_set": "geosite-steam-cn",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-steam",
        "action": "route",
        "outbound": "steam"
      },
      {
        "rule_set": "geosite-telegram",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/geoip-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-ads",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-category-ads-all.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-google.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-google-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-google@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-youtube",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-youtube.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-microsoft",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-microsoft.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-microsoft-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-microsoft@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-github",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-github.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-apple",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-apple.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-apple-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-apple@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-openai",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-openai.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-anthropic",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-anthropic.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-jetbrains-ai",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-jetbrains-ai.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-category-ai-chat-!cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-category-ai-chat-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-steam",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-steam.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-steam-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-steam@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-telegram",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-telegram.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-geolocation-!cn.srs"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true,
    "default_domain_resolver": "local-dns",
    "default_http_client": "rule-set-direct"
  },
  "http_clients": [
    {
      "tag": "rule-set-direct",
      "detour": "direct"
    }
  ]
}
